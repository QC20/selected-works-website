DISABLE_ESLINT_PLUGIN=true
ESLINT_NO_DEV_ERRORS=true
TSC_COMPILE_ON_ERROR=true

# Guestbook (message board) storage — Supabase.
# Leave blank to run the guestbook in local-only demo mode (messages saved in the
# visitor's own browser). Fill both to make messages global & persistent.
# The anon key is public/safe to ship (the table is protected by an RLS policy —
# see src/components/applications/guestbookApi.ts for the one-time SQL setup).
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=

